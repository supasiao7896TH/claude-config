# set -e สำคัญมาก: ถ้าไม่มี exit code ของ hook จะเป็นของ "คำสั่งสุดท้าย" เท่านั้น
# คำสั่งก่อนหน้าที่ล้มเหลวจะถูกกลืนหายไป และ commit จะผ่านทั้งที่ gate แดง
# (เจอบักนี้จริงตอนทดสอบ 2026-09-02 — secretlint จับ key ได้ แต่ commit ยังผ่าน)
set -e

# hook นี้ต้องเร็ว (<3 วิ) ไม่งั้นจะถูกข้ามด้วย --no-verify ซึ่ง sa-git-manager ห้ามไว้
# ของหนัก (Playwright/branding build) ปล่อยให้ CI รัน
npx lint-staged
node tools/check-standards.mjs
